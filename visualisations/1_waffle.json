{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "ABS 2021 Australian housing tenure waffle chart. Each square represents 1% of dwellings with a known tenure classification.",
  "padding": 0,

  "title": {
    "text": "Housing Status of Private Dwellings",
    "subtitle": "Share of occupied private dwellings by tenure, Australia, 2021",

    "anchor": "start",
    "align": "left",

    "font": "Roboto",
    "fontSize": 20,
    "fontWeight": 700,
    "color": "#03045e",

    "subtitleFont": "Roboto",
    "subtitleFontSize": 12,
    "subtitleFontWeight": 400,
    "subtitleColor": "#4f6f7f",

    "offset": 10
  },

  "width": "container",
  "height": 360,
  "background": null,

  "data": {
    "sequence": {
      "start": 0,
      "stop": 100,
      "as": "tile"
    }
  },

  "transform": [
    {
      "calculate": "datum.tile % 10",
      "as": "col"
    },
    {
      "calculate": "9 - floor(datum.tile / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.tile < 31 ? 'Owned outright' : datum.tile < 67 ? 'Mortgage' : datum.tile < 98 ? 'Rented' : 'Other'",
      "as": "tenure"
    }
  ],

  "mark": {
    "type": "rect",
    "cornerRadius": 3,
    "stroke": "#f5fcff",
    "strokeWidth": 2
  },

  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },

    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },

    "color": {
      "field": "tenure",
      "type": "nominal",
      "scale": {
        "domain": [
          "Owned outright",
          "Mortgage",
          "Rented",
          "Other"
        ],
        "range": [
          "#4E79A7",
          "#F28E2B",
          "#76B7B2",
          "#B07AA1"
        ]
      },

      "legend": {
        "title": null,
        "orient": "bottom",
        "columns": 2,

        "labelFont": "Roboto",
        "labelFontSize": 12,
        "labelFontWeight": 400,
        "labelColor": "#03045e",

        "symbolType": "square",
        "symbolSize": 120,

        "columnPadding": 18,
        "rowPadding": 6
      }
    },

    "tooltip": [
      {
        "field": "tenure",
        "type": "nominal",
        "title": "Tenure"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },

    "font": "Roboto",

    "axis": {
      "labelFont": "Roboto",
      "titleFont": "Roboto",
      "labelColor": "#03045e",
      "titleColor": "#03045e"
    },

    "legend": {
      "labelFont": "Roboto",
      "titleFont": "Roboto",
      "labelColor": "#03045e",
      "titleColor": "#03045e"
    }
  }
}
