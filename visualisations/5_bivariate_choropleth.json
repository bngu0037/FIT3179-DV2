{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "2021 bivariate SA2 choropleth of renter share and median weekly rent across seven ABS greater capital-city regions; pooled thresholds for direct comparison. The map and colour key share one layered view for reliable container sizing. The map and colour key share one layered view for reliable container sizing.",
  "background": null,
  "padding": 0,
  "title": {
    "text": {
      "expr": "width < 400 ? ['Where Do High Renting', 'and High Rent Overlap?'] : 'Where Do High Renting and High Rent Overlap?'"
    },
    "subtitle": "SA2 renter share and median weekly rent, 2021.",
    "anchor": "start",
    "align": "left",
    "font": "Roboto",
    "fontSize": 20,
    "fontWeight": 700,
    "color": "#03045e",
    "subtitleFont": "Roboto",
    "subtitleFontSize": 12,
    "subtitleFontWeight": 400,
    "subtitleColor": "#4f6f7f",
    "offset": 10,
    "frame": "group",
    "limit": {
      "expr": "width - 4"
    }
  },
  "params": [
    {
      "name": "metroArea",
      "value": "2GMEL",
      "bind": {
        "input": "select",
        "name": "Metro area: ",
        "options": [
          "2GMEL",
          "1GSYD",
          "3GBRI",
          "4GADE",
          "5GPER",
          "6GHOB",
          "7GDAR"
        ],
        "labels": [
          "Greater Melbourne",
          "Greater Sydney",
          "Greater Brisbane",
          "Greater Adelaide",
          "Greater Perth",
          "Greater Hobart",
          "Greater Darwin"
        ]
      }
    },
    {
      "name": "mapZoom",
      "value": 1,
      "bind": {
        "input": "range",
        "name": "Zoom: ",
        "min": 0.65,
        "max": 1.8,
        "step": 0.05
      }
    },
    {
      "name": "metroSpanX",
      "expr": "metroArea == '2GMEL' ? 0.021051 : metroArea == '1GSYD' ? 0.025890 : metroArea == '3GBRI' ? 0.020615 : metroArea == '4GADE' ? 0.009033 : metroArea == '5GPER' ? 0.013932 : metroArea == '6GHOB' ? 0.012005 : 0.010092"
    },
    {
      "name": "metroSpanY",
      "expr": "metroArea == '2GMEL' ? 0.023186 : metroArea == '1GSYD' ? 0.022922 : metroArea == '3GBRI' ? 0.034714 : metroArea == '4GADE' ? 0.014644 : metroArea == '5GPER' ? 0.023568 : metroArea == '6GHOB' ? 0.007635 : 0.014752"
    },
    {
      "name": "metroCenterX",
      "expr": "metroArea == '2GMEL' ? 0.1816595 : metroArea == '1GSYD' ? 0.270715 : metroArea == '3GBRI' ? 0.3178095 : metroArea == '4GADE' ? 0.0960325 : metroArea == '5GPER' ? -0.235077 : metroArea == '6GHOB' ? 0.2040135 : -0.01551"
    },
    {
      "name": "metroCenterY",
      "expr": "metroArea == '2GMEL' ? 0.234612 : metroArea == '1GSYD' ? 0.172412 : metroArea == '3GBRI' ? 0.067802 : metroArea == '4GADE' ? 0.1774 : metroArea == '5GPER' ? 0.14113 : metroArea == '6GHOB' ? 0.3243185 : -0.219341"
    },
    {
      "name": "metroFitScale",
      "expr": "min(width * 0.9 / metroSpanX, (height - 190) * 0.9 / metroSpanY)"
    }
  ],
  "config": {
    "font": "Roboto",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Roboto",
      "titleFont": "Roboto"
    },
    "legend": {
      "labelFont": "Roboto",
      "titleFont": "Roboto"
    }
  },
  "width": "container",
  "height": 800,
  "projection": {
    "type": "albers",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ],
    "center": [
      0,
      -25
    ],
    "scale": {
      "expr": "mapZoom * metroFitScale"
    },
    "translate": {
      "expr": "[width / 2 - mapZoom * metroFitScale * metroCenterX, (height - 190) / 2 - mapZoom * metroFitScale * metroCenterY]"
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#009DC4"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "x2": {
          "value": {
            "expr": "width"
          }
        },
        "y": {
          "value": {
            "expr": "0"
          }
        },
        "y2": {
          "value": {
            "expr": "height - 190"
          }
        }
      }
    },
    {
      "data": {
        "url": "data/sa2_2021_metros.topojson",
        "format": {
          "type": "topojson",
          "feature": "metros"
        }
      },
      "transform": [
        {
          "lookup": "properties.sa2_code",
          "from": {
            "data": {
              "url": "data/sa2_renter_share_median_rent_2021.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "sa2_code": "string",
                  "renter_share_pct": "number",
                  "median_weekly_rent_aud": "number",
                  "renter_dwellings": "number",
                  "known_tenure_dwellings": "number"
                }
              }
            },
            "key": "sa2_code",
            "fields": [
              "renter_dwellings",
              "known_tenure_dwellings",
              "renter_share_pct",
              "median_weekly_rent_aud",
              "renter_band",
              "rent_band",
              "bi_class",
              "coverage"
            ]
          }
        },
        {
          "filter": "datum.properties.metro_code == metroArea"
        },
        {
          "filter": "datum.bi_class == null || datum.bi_class == \"\""
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#C2BFB8",
        "stroke": "#F5FCFF",
        "strokeWidth": 0.22,
        "clip": true
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.sa2_name",
            "type": "nominal",
            "title": "SA2"
          },
          {
            "field": "properties.metro_name",
            "type": "nominal",
            "title": "Metro area"
          },
