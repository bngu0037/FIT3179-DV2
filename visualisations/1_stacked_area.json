{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Stacked area chart showing how the composition of Australian housing tenure changed over time.",
  "padding": 0,

  "title": {
    "text": "Housing Tenure Over Time",
    "subtitle": "Share of households by tenure, 1994-95 to 2019-20",
    "anchor": "start",
    "align": "left",
    "font": "Roboto",
    "fontSize": 20,
    "fontWeight": 700,
    "color": "#03045e",
    "subtitleFont": "Roboto",
    "subtitleFontSize": 12,
    "subtitleFontWeight": 400,
    "subtitleColor": "#4f6f7f",
    "offset": 10
  },

  "width": "container",
  "height": 360,
  "background": null,

  "data": {
    "url": "data/tenure_longrun_all_years.csv"
  },

  "transform": [
    {
      "calculate": "format(datum.pct, '.1f') + '%'",
      "as": "pct_label"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.96,
        "stroke": "#f5fcff",
        "strokeWidth": 1
      },

      "encoding": {
    "x": {
      "field": "year_order",
      "type": "quantitative",

      "scale": {
        "nice": false,
        "zero": false,
        "padding": 0
      },

      "axis": {
        "title": null,
        "values": [1, 4, 7, 10, 13, 16],
        "labelExpr": "datum.value == 1 ? '1994-95' : datum.value == 4 ? '1999-00' : datum.value == 7 ? '2003-04' : datum.value == 10 ? '2009-10' : datum.value == 13 ? '2015-16' : datum.value == 16 ? '2019-20' : ''",

        "labelFont": "Roboto",
        "labelFontSize": 12,
        "labelColor": "#4f6f7f",

        "tickColor": "#b8cbd5",
        "domainColor": "#b8cbd5",

        "grid": false,
        "offset": 0
      }
    },

    "y": {
      "field": "pct",
      "type": "quantitative",
      "stack": "center",
      "scale": {
        "nice": false
      },
      "axis": {
        "title": "Share of households (%)",
        "titleFont": "Roboto",
        "titlePadding": 12,
        "titleFontSize": 12,
        "titleFontWeight": 500,
        "titleColor": "#03045e",
        "labelFont": "Roboto",
        "labelFontSize": 12,
        "labelColor": "#03045e",
        "labelAngle": 0,
        "labelPadding": 6,
        "labels": false,
        "ticks": false,
        "domain": false,
        "grid": false
      }
    },

    "color": {
      "field": "tenure",
      "type": "nominal",
      "scale": {
        "domain": [
          "Owned outright",
          "Mortgage",
          "Rented",
          "Other"
        ],
        "range": [
          "#4E79A7",
          "#F28E2B",
          "#76B7B2",
          "#B07AA1"
        ]
      },
      "legend": {
        "title": null,
        "orient": "bottom",
        "columns": 4,
        "labelFont": "Roboto",
        "labelFontSize": 12,
        "labelFontWeight": 400,
        "labelColor": "#03045e",
        "symbolType": "square",
        "symbolSize": 120,
        "columnPadding": 18,
        "rowPadding": 6
      }
    },

    "order": {
      "field": "tenure",
      "sort": [
        "Owned outright",
        "Mortgage",
        "Rented",
        "Other"
      ]
    },

        "tooltip": [
          {
            "field": "year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "tenure",
            "type": "nominal",
            "title": "Tenure"
          },
          {
            "field": "pct_label",
            "type": "nominal",
            "title": "Share"
          }
        ]
      }
    },
    {
      "data": {
        "values": [{ "year_order": 8 }]
      },
      "mark": {
        "type": "rule",
        "color": "#03045e",
        "strokeWidth": 1.25,
        "strokeDash": [4, 4],
        "opacity": 0.5
      },
      "encoding": {
        "x": {
          "field": "year_order",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [{ "year_order": 8, "annotation_y": 46 }]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 7,
        "dy": -10,
        "font": "Roboto",
        "fontSize": 12,
        "fontWeight": 400,
        "color": "#03045e"
      },
      "encoding": {
        "x": {
          "field": "year_order",
          "type": "quantitative"
        },
        "y": {
          "field": "annotation_y",
          "type": "quantitative"
        },
        "text": {
          "value": [
            "Mortgages overtake",
            "outright ownership"
          ]
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "font": "Roboto",

    "axis": {
      "labelFont": "Roboto",
      "titleFont": "Roboto",
      "labelColor": "#03045e",
      "titleColor": "#03045e"
    },

    "legend": {
      "labelFont": "Roboto",
      "titleFont": "Roboto",
      "labelColor": "#03045e",
      "titleColor": "#03045e"
    }
  }
}
