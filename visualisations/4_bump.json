{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Mortgage Becomes Dominant at Higher Incomes",
    "subtitle": "Rank of housing tenure types across weekly household income bands, 2021.",
    "anchor": "start",
    "align": "left",
    "font": "Roboto",
    "fontSize": 20,
    "fontWeight": 700,
    "color": "#03045e",
    "subtitleFont": "Roboto",
    "subtitleFontSize": 12,
    "subtitleFontWeight": 400,
    "subtitleColor": "#4f6f7f",
    "offset": 10
  },

  "width": "container",
  "height": 360,

  "background": null,
  "padding": 0,

  "data": {
    "url": "data/section4_income_bump.csv"
  },

  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "point": false
      },

      "encoding": {
        "x": {
          "field": "income_band",
          "type": "ordinal",

          "sort": [
            "Under $800",
            "$800-1,499",
            "$1,500-2,499",
            "$2,500-3,499",
            "$3,500+"
          ],

          "title": "Weekly household income",

          "axis": {
            "labelAngle": 0,
            "labelFont": "Roboto",
            "labelFontSize": 11,
            "labelColor": "#4f6f7f",
            "labelPadding": 8,

            "titleFont": "Roboto",
            "titleFontSize": 12,
            "titleFontWeight": 500,
            "titleColor": "#03045e",
            "titlePadding": 12,

            "domain": false,
            "ticks": false,
            "grid": false
          }
        },

        "y": {
          "field": "rank",
          "type": "quantitative",

          "scale": {
            "domain": [4.35, 0.65],
            "nice": false
          },

          "title": "Rank",

          "axis": {
            "values": [1, 2, 3, 4],
            "labelExpr": "'Rank ' + datum.value",

            "labelFont": "Roboto",
            "labelFontSize": 11,
            "labelColor": "#4f6f7f",

            "titleFont": "Roboto",
            "titleFontSize": 12,
            "titleFontWeight": 500,
            "titleColor": "#03045e",
            "titlePadding": 10,

            "grid": true,
            "gridColor": "#dce8ee",
            "gridOpacity": 0.7,
            "gridDash": [3, 3],

            "domain": false,
            "ticks": false
          }
        },

        "color": {
          "field": "tenure",
          "type": "nominal",

          "scale": {
            "domain": [
              "Owned outright",
              "Mortgage",
              "Rented",
              "Other"
            ],

            "range": [
              "#4E79A7",
              "#F28E2B",
              "#76B7B2",
              "#B07AA1"
            ]
          },

          "legend": {
            "orient": "top",
            "direction": "horizontal",

            "title": null,

            "labelFont": "Roboto",
            "labelFontSize": 12,
            "labelFontWeight": 400,
            "labelColor": "#03045e",

            "symbolStrokeWidth": 3,
            "symbolSize": 120
          }
        },

        "detail": {
          "field": "tenure"
        }
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 130,
        "stroke": "#f5fcff",
        "strokeWidth": 2
      },

      "encoding": {
        "x": {
          "field": "income_band",
          "type": "ordinal",

          "sort": [
            "Under $800",
            "$800-1,499",
            "$1,500-2,499",
            "$2,500-3,499",
            "$3,500+"
          ]
        },

        "y": {
          "field": "rank",
          "type": "quantitative",

          "scale": {
            "domain": [4.35, 0.65],
            "nice": false
          }
        },

        "color": {
          "field": "tenure",
          "type": "nominal",

          "scale": {
            "domain": [
              "Owned outright",
              "Mortgage",
              "Rented",
              "Other"
            ],

            "range": [
              "#4E79A7",
              "#F28E2B",
              "#76B7B2",
              "#B07AA1"
            ]
          },

          "legend": null
        },

        "tooltip": [
          {
            "field": "tenure",
            "type": "nominal",
            "title": "Tenure"
          },
          {
            "field": "income_band",
            "type": "ordinal",
            "title": "Weekly income"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank",
            "format": ".0f"
          },
          {
            "field": "share_label",
            "type": "nominal",
            "title": "Tenure share"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Dwellings",
            "format": ","
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.income_band === '$3,500+'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,

        "font": "Roboto",
        "fontSize": 11,
        "fontWeight": 500
      },

      "encoding": {
        "x": {
          "field": "income_band",
          "type": "ordinal",

          "sort": [
            "Under $800",
            "$800-1,499",
            "$1,500-2,499",
            "$2,500-3,499",
            "$3,500+"
          ]
        },

        "y": {
          "field": "rank",
          "type": "quantitative",

          "scale": {
            "domain": [4.35, 0.65],
            "nice": false
          }
        },

        "text": {
          "field": "tenure"
        },

        "color": {
          "field": "tenure",
          "type": "nominal",

          "scale": {
            "domain": [
              "Owned outright",
              "Mortgage",
              "Rented",
              "Other"
            ],

            "range": [
              "#4E79A7",
              "#F28E2B",
              "#76B7B2",
              "#B07AA1"
            ]
          },

          "legend": null
        }
      }
    }
  ],

  "config": {
    "font": "Roboto",

    "view": {
      "stroke": null
    },

    "axis": {
      "labelFont": "Roboto",
      "titleFont": "Roboto"
    },

    "legend": {
      "labelFont": "Roboto",
      "titleFont": "Roboto"
    }
  }
}